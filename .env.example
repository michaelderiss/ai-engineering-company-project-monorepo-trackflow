# ======================================================================
# TrackFlow — Environment template
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# For Docker development, see `.env.docker` for a ready-to-use template
# with SQLite (no external Postgres needed).
#
# Docker Compose automatically loads the `.env` file from the repo root.
# ======================================================================

JWT_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:6543/postgres?sslmode=require
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=TrackFlow <no-reply@your-verified-domain.com>
BACKOFFICE_URL=http://localhost:3000

# --- CORS (comma-separated browser origins for production) ------------
# The API's CORS middleware only allows these origins in the browser.
# In Docker dev the defaults (localhost:3000,3001) work because the
# browser connects via localhost.  Set your real domain(s) here for
# production, e.g. "https://admin.trackflow.com,https://trackflow.com".
CORS_ORIGINS=

# --- Next.js public API URLs -----------------------------------------
# WARNING: NEXT_PUBLIC_* vars are baked into client-side JS that runs
# in the USER'S BROWSER.  The browser cannot resolve Docker service
# names.  ALWAYS use a URL that the browser can reach:
#
#   Local dev (native or Docker):  http://localhost:8000
#   Production:                    https://api.yourdomain.com
#
NEXT_PUBLIC_INCIDENTS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000